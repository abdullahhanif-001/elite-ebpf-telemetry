From d34f4990f3180736198efcdee7352481cc709c5f Mon Sep 17 00:00:00 2001
From: Abdullah Hanif <318923962+abdullahhanif-001@users.noreply.github.com>
Date: Fri, 23 Oct 2026 10:00:42 +0000
Subject: [PATCH] mbset: fix followChildren ID leak on duplicate paths

Skip ebpf.ErrKeyNotExist when removing duplicate matchBinaries paths
so RemoveID still releases the mbset ID. Deduplicate paths at write
time. Release ID from state when execve updater is nil (small progs).

Fixes cilium/tetragon#5744
---
 pkg/mbset/mbset.go                        |  7 +++++++
 pkg/selectors/matchbinaries_paths_test.go | 19 +++++++++++++++++++
 pkg/selectors/selectors.go                |  5 +++++
 3 files changed, 31 insertions(+)
 create mode 100644 pkg/selectors/matchbinaries_paths_test.go

diff --git a/pkg/mbset/mbset.go b/pkg/mbset/mbset.go
index 3878051..1aa19c5 100644
--- a/pkg/mbset/mbset.go
+++ b/pkg/mbset/mbset.go
@@ -73,6 +73,8 @@ func (s *state) RemoveID(id uint32, paths [][processapi.BINARY_PATH_MAX_LEN]byte
 	defer s.mu.Unlock()
 
 	if update == nil {
+		// No execve_map updater (small programs): still release the ID slot.
+		delete(s.ids, id)
 		return nil
 	}
 
@@ -104,6 +106,11 @@ func (s *state) RemoveID(id uint32, paths [][processapi.BINARY_PATH_MAX_LEN]byte
 
 		err := mbsetMap.Lookup(path, &val)
 		if err != nil {
+			// Duplicate paths in one selector hit Delete on the first copy;
+			// a second Lookup returns ErrKeyNotExist — continue, do not leak ID.
+			if errors.Is(err, ebpf.ErrKeyNotExist) {
+				continue
+			}
 			return fmt.Errorf("failed to lookup mbset map: %w", err)
 		}
 
diff --git a/pkg/selectors/matchbinaries_paths_test.go b/pkg/selectors/matchbinaries_paths_test.go
new file mode 100644
index 0000000..6befaad
--- /dev/null
+++ b/pkg/selectors/matchbinaries_paths_test.go
@@ -0,0 +1,19 @@
+// SPDX-License-Identifier: Apache-2.0
+
+package selectors
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestWriteMatchBinariesPathDedupes(t *testing.T) {
+	k := NewKernelSelectorState(nil, nil, false, 0, nil, nil)
+	k.WriteMatchBinariesPath(0, "/usr/bin/cat")
+	k.WriteMatchBinariesPath(0, "/usr/bin/cat")
+	k.WriteMatchBinariesPath(0, "/usr/bin/echo")
+
+	paths := k.MatchBinariesPaths()[0]
+	require.Len(t, paths, 2)
+}
diff --git a/pkg/selectors/selectors.go b/pkg/selectors/selectors.go
index acdba74..c63e9a4 100644
--- a/pkg/selectors/selectors.go
+++ b/pkg/selectors/selectors.go
@@ -234,6 +234,11 @@ func (k KernelSelectorState) MatchWorkloadIDs() map[int]policyfilter.PolicyID {
 func (k *KernelSelectorState) WriteMatchBinariesPath(selectorID int, path string) {
 	var bytePath [processapi.BINARY_PATH_MAX_LEN]byte
 	copy(bytePath[:], path)
+	for _, existing := range k.matchBinariesPaths[selectorID] {
+		if existing == bytePath {
+			return
+		}
+	}
 	k.matchBinariesPaths[selectorID] = append(k.matchBinariesPaths[selectorID], bytePath)
 }
 
