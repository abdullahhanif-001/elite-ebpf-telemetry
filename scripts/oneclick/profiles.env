# Elite one-click profiles → feature bitmask
# Sourced by elite-oneclick.sh. Features are space-separated tokens.
# Core features: physics forecast llc dcic
# Optional compose: ig netstacklat obi parca kepler sec

PROFILE_minimal=" "
PROFILE_physics="physics"
PROFILE_predict="physics forecast"
PROFILE_llc="physics forecast llc"
PROFILE_dcic_soft="physics forecast dcic"
PROFILE_closed_loop="physics forecast llc dcic"
PROFILE_ecgf="physics forecast llc dcic ecgf"
# full = fleet observe default: physics exporters + predict + llc + Soft DCIC + ECGF + IG note
PROFILE_full="forecast llc dcic ecgf ig"
PROFILE_compose_ig="physics forecast ig"
PROFILE_compose_netstacklat="physics forecast netstacklat"
PROFILE_compose_obi="physics forecast obi"
PROFILE_compose_parca="physics forecast parca"
PROFILE_compose_kepler="physics forecast kepler"
PROFILE_compose_sec="physics forecast sec"

# Default when Soft DCIC artifacts already present on host
DEFAULT_PROFILE_IF_DCIC="full"
DEFAULT_PROFILE="full"

# Math / ops knobs (override via environment before install)
FORECAST_ALPHA="${FORECAST_ALPHA:-0.3}"
FORECAST_WINDOW="${FORECAST_WINDOW:-8}"
FORECAST_HORIZON="${FORECAST_HORIZON:-5s}"
HARD_DROP_SECONDS="${HARD_DROP_SECONDS:-0.1}"
LLC_SAMPLE_PERIOD="${LLC_SAMPLE_PERIOD:-10000}"
LLC_ENABLED="${LLC_ENABLED:-auto}"
DCIC_MODE="${DCIC_MODE:-observe}"
ACTUATE_TRACK="${ACTUATE_TRACK:-auto}"
CPU_QUOTA_PCT="${CPU_QUOTA_PCT:-5}"
