# Elite Physics Pack — pinned upstream versions (Path A VPS + Path B K8s)
# Do not invent BPF here; only compose GitHub/apt artifacts.

# Cloudflare ebpf_exporter (prebuilt binary + example BPF objects)
EBPF_EXPORTER_REPO="cloudflare/ebpf_exporter"
EBPF_EXPORTER_VERSION="v2.5.1"
EBPF_EXPORTER_LISTEN="127.0.0.1:9435"

# Example program set shipped inside ebpf_exporter_with_examples tarball
# (covers softirq, skb free, TCP retransmit, UDP drops, mm shrink latency, XDP counters)
EBPF_EXPORTER_CONFIG_NAMES="softirq-latency-net-rx,kfree_skb,tcp-retransmit,udp-drops,shrinklat"

# Optional netstacklat (xdp-project) — config only; BPF build skipped unless clang present
BPF_EXAMPLES_REPO="xdp-project/bpf-examples"
BPF_EXAMPLES_COMMIT="1769d51faeb96a1d94d68affcc06f5c71de03de5"
NETSTACKLAT_OPTIONAL="1"

# Inspektor Gadget host binary
IG_REPO="inspektor-gadget/inspektor-gadget"
IG_VERSION="v0.55.1"
IG_METRICS_LISTEN="127.0.0.1:2224"

# Elite agent (existing)
ELITE_METRICS_LISTEN="127.0.0.1:9102"
# Release channel for install.sh / elite-updater (GitHub Releases tag or latest)
ELITE_RELEASE_REPO="abdullahhanif-001/elite-ebpf-telemetry"
ELITE_AGENT_ASSET_PREFIX="elite-agent.linux"
ELITE_UPDATER_ASSET_PREFIX="elite-updater.linux"

# Ubuntu/Debian BCC tools package (apt)
BCC_APT_PACKAGE="bpfcc-tools"

# Kubernetes Path B pins
KUBESKOOP_SKOOPBUNDLE_URL="https://raw.githubusercontent.com/alibaba/kubeskoop/main/deploy/skoopbundle.yaml"
RETINA_CHART="oci://ghcr.io/microsoft/retina/charts/retina"
# Retina tag resolved at install time from GitHub API; floor documented here:
RETINA_VERSION_FLOOR="v1.2.5"

# Install roots
PHYSICS_PACK_ROOT="/opt/elite/physics-pack"
ELITE_ROOT="/opt/elite"
